{
  "name": "curidocs",
  "version": "0.1.0",
  "private": true,
  "description": "Base técnica para el sistema de gestión documental CuriDocs.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "turbo build",
    "check": "pnpm format:check && turbo lint typecheck test build",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:up": "docker compose up -d db",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@curidocs/api",
    "dev:web": "turbo dev --filter=@curidocs/web",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7"
  }
}
